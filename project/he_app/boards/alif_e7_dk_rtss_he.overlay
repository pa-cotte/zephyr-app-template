&gpio8 {
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_gpio8>;
};

&gpio5 {
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_gpio5>;
};

&gpio12 {
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_gpio12>;
};

&spi3 {
  status = "okay";

  wifi0:winc1500@0 {
    status = "ok";
    compatible = "atmel,winc1500";
    reg = <0x0>;         
    spi-max-frequency = <4000000>;
    irq-gpios = <&gpio8 1 GPIO_ACTIVE_LOW>;
    reset-gpios = <&gpio8 3 GPIO_ACTIVE_HIGH>;
    enable-gpios = <&gpio5 6 GPIO_ACTIVE_HIGH>;
  };
};