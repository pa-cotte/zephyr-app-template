&spi3 {
  status = "okay";

  wifi0:winc1500@0 {
    status = "ok";
    compatible = "atmel,winc1500";
    reg = <0x0>;
    spi-max-frequency = <4000000>;
    irq-gpios = <&gpio8 1 GPIO_ACTIVE_HIGH>;
    reset-gpios = <&gpio8 3 GPIO_ACTIVE_LOW>;
    enable-gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;
  };
};
