{
    "version": "2.0.0",
    "tasks": [
        // Task triggered by "Buttons"
        {
            "label": "Build",
            "type": "shell",
            "command": "west build -p auto -b alif_e7_dk_rtss_he --sysbuild project/he_app && sudo cp -f ${workspaceFolder}/tools/alif/device_config.json ${ALIF_SE_TOOLS}/build/config/device_config.json",
            "group": {
                "kind": "build",
                "isDefault": true
            },
        },
        {
            "label": "Flash",
            "type": "shell",
            "command": "sudo cp -f ${workspaceFolder}/build/he_app/zephyr/zephyr.bin ${ALIF_SE_TOOLS}/build/images/he_app.bin && sudo cp -f ${workspaceFolder}/build/hp_app/zephyr/zephyr.bin ${ALIF_SE_TOOLS}/build/images/hp_app.bin && cd ${ALIF_SE_TOOLS} && sudo ${ALIF_SE_TOOLS}/app-gen-toc -f ${workspaceFolder}/tools/alif/e7_he_hp.json && sudo ${ALIF_SE_TOOLS}/app-write-mram -p",
            "group": "test",
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": [
                "rm -rf build",
                "sudo rm -rf ${ALIF_SE_TOOLS}/build/*"
            ],
            "group": "build",
            "presentation": {
                "clear": true
            },
        },
        // Task triggered by "F1 -> run Task" 
        {
            "label": "Maintenance",
            "type": "shell",
            "command": "cd ${ALIF_SE_TOOLS} && sudo ${ALIF_SE_TOOLS}/maintenance",
            "group": "test",
        },
        {
            "label": "Erase MRAM",
            "type": "shell",
            "command": "cd ${ALIF_SE_TOOLS} && sudo ${ALIF_SE_TOOLS}/app-write-mram -e APP",
            "group": "build",
        },
        {
            "label": "Build HP only",
            "type": "shell",
            "command": "west build -p auto -b alif_e7_dk_rtss_hp --sysbuild project/hp_app",
            "group": {
                "kind": "build",
                "isDefault": true
            },
        },
        {
            "label": "Build stubs",
            "type": "shell",
            "command": "cd ${ALIF_SE_TOOLS} && sudo ${ALIF_SE_TOOLS}/app-gen-toc -f ${ALIF_SE_TOOLS}/build/config/app-cpu-stubs.json",
            "group": {
                "kind": "build",
            },
        },
        {
            "label": "Build and Flash stubs",
            "type": "shell",
            "command": "cd ${ALIF_SE_TOOLS} && sudo ${ALIF_SE_TOOLS}/app-write-mram -p",
            "group": {
                "kind": "build",
            },
            "dependsOn": [
                "Build stubs"
            ],
        }
    ],
}