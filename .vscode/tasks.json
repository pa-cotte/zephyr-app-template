{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "west build -p auto -b ${input:board_app} project/app && sudo cp -f ${workspaceFolder}/build/zephyr/zephyr.bin ${ALIF_SE_TOOLS}/build/images/zephyr_e7_rtsshp.bin && cd ${ALIF_SE_TOOLS} && sudo ./app-gen-toc -f ${workspaceFolder}/tools/alif/zephyr_e7_rtsshp.json",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "clear": true
            }
        },
        {
            "label": "Set COM port",
            "type": "shell",
            "command": "cd ${ALIF_SE_TOOLS} && sudo ${ALIF_SE_TOOLS}/maintenance -d",
            "group": "test",
        },
        {
            "label": "Flash",
            "type": "shell",
            "command": "cd ${ALIF_SE_TOOLS} && sudo ${ALIF_SE_TOOLS}/app-write-mram -p",
            "group": "test",
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "rm -rf build",
            "group": "build"
        },
    ],
    "inputs": [
        {
            "type": "pickString",
            "id": "board_app",
            "description": "Target board",
            "options": [
                "nucleo_l476rg",
                "alif_e7_dk_rtss_hp",
            ],
            "default": "nucleo_l476rg"
        }
    ]
}